# Server only. Leave this empty to rehearse in DEMO_MODE.
# When it is set, the app uses the real Cursor SDK even if DEMO_MODE is also set.
CURSOR_API_KEY=

# GitHub repository you created from the template/ folder.
TEMPLATE_REPO_URL=https://github.com/your-org/app-template

# Branch the cloud agent starts from.
TEMPLATE_STARTING_REF=main

# Documentation only. DEMO_MODE turns on automatically when CURSOR_API_KEY is empty.
# It does not override a real key.
DEMO_MODE=

# Plays the scripted build and the simulated release faster. 1 is real time
# (about 50 seconds for a build, 40 for a release).
DEMO_SPEED=

# Sidebar user and environment pill. SSO stand-ins.
STUDIO_USER_NAME=Jordan Stein
STUDIO_USER_ROLE=Field Engineer

# Optional read token for the private template repo. Watches the release pull request
# and fetches public/index.html. Without it the server uses the signed-in `gh` CLI.
GITHUB_TOKEN=

# Live mode: show the last approved Permian briefing while the example card builds.
# On unless set to 0, false, off or no.
FAST_PATH_CACHE=

# Testing only: open | merged | error | merge-after-<seconds>. Replaces the GitHub read.
PR_WATCH_MOCK=
